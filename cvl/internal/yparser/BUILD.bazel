load("@io_bazel_rules_go//go:def.bzl", "go_library")

go_library(
    name = "yparser",
    srcs = [
        "ly_path.go",
        "yparser.go",
    ],
    cdeps = [
        "@com_github_cesnet_libyang//:libyang",
        "//:libyang_cgo_headers",
    ],
    cgo = True,
    # TODO BL: Fix this.
    # When consumed as an external module, includes from cc_library don't
    # propagate through cgo. Add the include path explicitly.
    cppopts = [
        "-isystem $(BINDIR)/external/sonic-mgmt-common+/libyang_headers_dir",
        "-isystem external/sonic-mgmt-common+/libyang_headers_dir",
    ],
    importpath = "github.com/Azure/sonic-mgmt-common/cvl/internal/yparser",
    visibility = ["//cvl:__subpackages__"],
    deps = ["//cvl/internal/util"],
)

alias(
    name = "go_default_library",
    actual = ":yparser",
    visibility = ["//cvl:__subpackages__"],
)
