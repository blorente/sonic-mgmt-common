go_test(
    name = "cvl_test",
    srcs = [
        "cvl_error_test.go",
        "cvl_hint_test.go",
        "cvl_leaflist_test.go",
        "cvl_leafref_test.go",
        "cvl_must_test.go",
        "cvl_test.go",
        "cvl_when_test.go",
        "jsondata_test.go",
    ],
    data = glob(["testdata/**"]) + [
        ":test-yin-files",
        "//cvl/conf:cvl_cfg.json",
        "//tools/test:database_config.json",
        "@sonic_libyang//:libyang",
    ],
    env = {
        "DB_CONFIG_PATH": "../tools/test/database_config.json",
        "CVL_CFG_FILE": "conf/cvl_cfg.json",
        "CVL_SCHEMA_PATH": "test-schema",
    },
    rundir = "cvl",
    deps = [
        ":cvl",
        "//cvl/common",
        "//cvl/internal/util",
        "//translib/db",
        "//translib/tlerr",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

genrule(
    name = "yin-files",
    srcs = [
        "//models/yang:generate-yangs",
    ],
    outs = ["yin-files.tar"],
    cmd = "tar xf $(location //models/yang:generate-yangs) && " +
          "./$(location //cvl/tools:generate_yin) -v --path=yang --path=yang/sonic --out-dir=yin_file_build && " +
          "pushd yin_file_build && tar --owner=root --group=root -cf ../$(OUTS) *.yin && popd",
    tools = ["//cvl/tools:generate_yin"],
)

pkg_tar(
    name = "_schema",
    mode = "0755",
    package_dir = "/usr/sbin/schema",
    visibility = ["//visibility:private"],
    deps = [":yin-files"],
)

pkg_tar(
    name = "_conf",
    srcs = ["//cvl/conf:files"],
    mode = "0755",
    package_dir = "/usr/sbin",
    visibility = ["//visibility:private"],
)

pkg_tar(
    name = "cvl_tar",
    out = "cvl.tar",
    mode = "0755",
    deps = [
        ":_conf",
        ":_schema",
    ],
)

alias(
    name = "go_default_library",
    actual = ":cvl",
    visibility = ["//visibility:public"],
)
