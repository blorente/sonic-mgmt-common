load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "cvl",
    srcs = [
        "cvl.go",
        "cvl_api.go",
        "cvl_cache.go",
        "cvl_hint.go",
        "cvl_luascript.go",
        "cvl_semantics.go",
        "cvl_syntax.go",
    ],
    importpath = "github.com/Azure/sonic-mgmt-common/cvl",
    visibility = ["//visibility:public"],
    deps = [
        "//cvl/common",
        "//cvl/custom_validation",
        "//cvl/internal/util",
        "//cvl/internal/yparser",
        "@com_github_antchfx_jsonquery//:jsonquery",
        "@com_github_antchfx_xmlquery//:xmlquery",
        "@com_github_antchfx_xpath//:xpath",
        "@com_github_google_go_cmp//cmp",
        "@com_github_philopon_go_toposort//:go-toposort",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

# Generate YIN files for CVL test schemas
genrule(
    name = "test-yin-files-tar",
    srcs = glob(["testdata/schema/*.yang"]) + [
        "//models/yang:sonic-common-yang",
        "//models/yang:common-yang",
    ],
    outs = ["test-schema.tar"],
    cmd = """
        mkdir -p _yang_tmp/testdata _yang_tmp/common
        for f in $(SRCS); do
            if echo "$$f" | grep -q "testdata/schema"; then
                cp "$$f" _yang_tmp/testdata/
            else
                cp "$$f" _yang_tmp/common/
            fi
        done
        mkdir -p _yin_out
        $(location //cvl/tools:generate_yin) --path=_yang_tmp/testdata --path=_yang_tmp/common --out-dir=_yin_out
        cp _yang_tmp/common/ietf-*.yang _yin_out/ 2>/dev/null || true
        tar cf $(OUTS) -C _yin_out .
    """,
    tools = ["//cvl/tools:generate_yin"],
)

genrule(
    name = "test-yin-files",
    srcs = [":test-yin-files-tar"],
    outs = [
        "test-schema/sonic-acl.yin",
        "test-schema/sonic-bgp-global.yin",
        "test-schema/sonic-buffer-pg.yin",
        "test-schema/sonic-buffer-pool.yin",
        "test-schema/sonic-buffer-profile.yin",
        "test-schema/sonic-cablelength.yin",
        "test-schema/sonic-common.yin",
        "test-schema/sonic-device-metadata.yin",
        "test-schema/sonic-device-neighbor.yin",
        "test-schema/sonic-dscp-tc-map.yin",
        "test-schema/sonic-extension.yin",
        "test-schema/sonic-ifa.yin",
        "test-schema/sonic-igmp-snooping.yin",
        "test-schema/sonic-interface.yin",
        "test-schema/sonic-leaflist-test.yin",
        "test-schema/sonic-loopback-interface.yin",
        "test-schema/sonic-mgmt_port.yin",
        "test-schema/sonic-mgmt_vrf.yin",
        "test-schema/sonic-mirror-session.yin",
        "test-schema/sonic-ospfv2.yin",
        "test-schema/sonic-pf-limits.yin",
        "test-schema/sonic-pfc-priority-queue-map.yin",
        "test-schema/sonic-port.yin",
        "test-schema/sonic-port-qos-map.yin",
        "test-schema/sonic-portchannel.yin",
        "test-schema/sonic-portchannel-interface.yin",
        "test-schema/sonic-queue.yin",
        "test-schema/sonic-scheduler.yin",
        "test-schema/sonic-sflow.yin",
        "test-schema/sonic-spanning-tree.yin",
        "test-schema/sonic-static-route.yin",
        "test-schema/sonic-tam.yin",
        "test-schema/sonic-tc-priority-group-map.yin",
        "test-schema/sonic-tc-queue-map.yin",
        "test-schema/sonic-telemetry.yin",
        "test-schema/sonic-telemetry_client.yin",
        "test-schema/sonic-test-xfmr.yin",
        "test-schema/sonic-types.yin",
        "test-schema/sonic-vlan.yin",
        "test-schema/sonic-vlan-interface.yin",
        "test-schema/sonic-vlan-subinterface.yin",
        "test-schema/sonic-vrf.yin",
        "test-schema/sonic-vxlan.yin",
        "test-schema/sonic-wred-profile.yin",
        "test-schema/ietf-inet-types.yang",
        "test-schema/ietf-interfaces.yang",
        "test-schema/ietf-yang-types.yang",
    ],
    cmd = "tar xf $(location :test-yin-files-tar) -C $$(dirname $(location test-schema/sonic-acl.yin))",
