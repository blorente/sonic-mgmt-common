load("@rules_pkg//:pkg.bzl", "pkg_tar")

filegroup(
    name = "exported_yangs",
    srcs = glob(["src/sonic-yang-models/yang-models/*.yang"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "exported_yang_templates",
    srcs = glob(["src/sonic-yang-models/yang-templates/*.yang.j2"]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "yang-file-export",
    srcs = [
        ":exported_yangs",
        ":exported_yang_templates",
    ],
    outs = [
        "sonic-yangs-export.tar",
        "sonic-yang-templates-export.tar",
    ],
    cmd = """
          mkdir -p _yangs_staging _templates_staging
          for f in $(locations :exported_yangs); do
              cp $$f _yangs_staging/
          done
          tar --sort=name --mtime='1970-01-01' --owner=0 --group=0 -cf $(@D)/sonic-yangs-export.tar -C _yangs_staging .
          for f in $(locations :exported_yang_templates); do
              cp $$f _templates_staging/
          done
          tar --sort=name --mtime='1970-01-01' --owner=0 --group=0 -cf $(@D)/sonic-yang-templates-export.tar -C _templates_staging .
          """,
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "sonic-cfggen",
    srcs = glob(["src/sonic-config-engine/*"], allow_empty = True),
    mode = "0644",
    package_dir = "/sonic-config-engine",
    # strip_prefix = "/testdata",
    visibility = ["//visibility:public"],
)
