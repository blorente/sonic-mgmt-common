# MODULE.bazel.standalone - Use this file when building sonic_mgmt_common STANDALONE
#
# To use: cp MODULE.bazel.standalone MODULE.bazel
#
# This file contains go_deps overrides (archive_override, gazelle_override) that are
# REQUIRED for building CVL but are FORBIDDEN in non-root Bazel modules.
# When sonic_mgmt_common is used as a dependency (e.g., by sonic-gnmi), the root
# module must provide these patches instead.

module(
    name = "sonic_mgmt_common",
    version = "1.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "protobuf", version = "29.0")
bazel_dep(name = "rules_go", version = "0.53.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.46.0")

# rules_distroless for hermetic Debian package dependencies
bazel_dep(name = "rules_distroless", version = "0.0.0")
local_path_override(
    module_name = "rules_distroless",
    path = "../rules_distroless",
)

# Python toolchain configuration
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.9",
)

# Pip dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_sonic_mgmt_common",
    python_version = "3.9",
    requirements_lock = "//third_party/pip:requirements_lock.txt",
)
use_repo(pip, "pip_sonic_mgmt_common")

# Go toolchain and dependencies
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.10")

# Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Patches for Go dependencies - REQUIRED for CVL to work
# These add custom xpath/jsonquery/xmlquery functions used by CVL
go_deps.archive_override(
    patch_strip = 1,
    patches = ["//patches:jsonquery.patch"],
    path = "github.com/antchfx/jsonquery",
    strip_prefix = "jsonquery-1.1.4",
    urls = ["https://github.com/antchfx/jsonquery/archive/refs/tags/v1.1.4.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = ["//patches:xmlquery.patch"],
    path = "github.com/antchfx/xmlquery",
    strip_prefix = "xmlquery-1.3.1",
    urls = ["https://github.com/antchfx/xmlquery/archive/refs/tags/v1.3.1.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = ["//patches:xpath.patch"],
    path = "github.com/antchfx/xpath",
    strip_prefix = "xpath-1.1.10",
    urls = ["https://github.com/antchfx/xpath/archive/refs/tags/v1.1.10.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = ["//patches:glog.patch"],
    path = "github.com/golang/glog",
    strip_prefix = "glog-23def4e6c14b4da8ac2ed8007337bc5eb5007998",
    urls = ["https://github.com/golang/glog/archive/23def4e6c14b4da8ac2ed8007337bc5eb5007998.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:github.com-openconfig-ygot.patch",
        "//patches/ygot:ygot.patch",
    ],
    path = "github.com/openconfig/ygot",
    strip_prefix = "ygot-0.13.1",
    urls = ["https://github.com/openconfig/ygot/archive/refs/tags/v0.13.1.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = ["//patches/goyang:goyang.patch"],
    path = "github.com/openconfig/goyang",
    strip_prefix = "goyang-0.2.9",
    urls = ["https://github.com/openconfig/goyang/archive/refs/tags/v0.2.9.tar.gz"],
)
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable"],
    path = "github.com/openconfig/gnmi",
)

# Expose all Go repositories that are referenced in BUILD files
use_repo(
    go_deps,
    "com_github_antchfx_jsonquery",
    "com_github_antchfx_xmlquery",
    "com_github_antchfx_xpath",
    "com_github_go_redis_redis_v7",
    "com_github_godbus_dbus_v5",
    "com_github_golang_glog",
    "com_github_golang_groupcache",
    "com_github_google_go_cmp",
    "com_github_kylelemons_godebug",
    "com_github_maruel_natural",
    "com_github_openconfig_gnmi",
    "com_github_openconfig_goyang",
    "com_github_openconfig_ygot",
    "com_github_philopon_go_toposort",
    "com_github_pkg_profile",
    "com_github_redis_go_redis_v9",
    "com_github_tredoe_osutil",
    "com_github_workiva_go_datastructures",
    "org_golang_google_grpc",
    "org_golang_x_text",
)

git_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "git_repository",
)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "bookworm",
        "bookworm-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20251001T023456Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20251001T023456Z"],
)
apt.install(
    dependency_set = "bookworm",
    packages = [
        "libpcre3",
        "libpcre3-dev",
    ],
    target_release = "bookworm",
)
apt.lock(into = ":packages.lock")
use_repo(apt, "bookworm")

# SONiC-built libyang 1.0.73 for bookworm
# These are built by SONiC and available from Azure DevOps artifacts
# libyang 1.x API is required for CGO bindings compatibility
sonic_libyang = use_repo_rule("//third_party/libyang:libyang.bzl", "sonic_libyang")

sonic_libyang(
    name = "sonic_libyang",
    dev_sha256 = "f34fe596c453d7b422e181a11f5897acefcee8d9dc2dfcdc29c91c64873f7fd0",
    dev_url = "https://sonic-build.azurewebsites.net/api/sonic/artifacts?branchName=202505&platform=vs&target=target%2Fdebs%2Fbookworm%2Flibyang-dev_1.0.73_amd64.deb",
    runtime_sha256 = "f389aaa244292f5d24d91b97320c28d4d59b4db2db4b76c59e5f66dfd4efb524",
    runtime_url = "https://sonic-build.azurewebsites.net/api/sonic/artifacts?branchName=202505&platform=vs&target=target%2Fdebs%2Fbookworm%2Flibyang_1.0.73_amd64.deb",
)

# Custom repositories not in BCR
git_repository(
    name = "sonic-buildimage",
    branch = "master",
    build_file = "//third_party/sonic_build_image:BUILD.external.bazel",
    remote = "https://github.com/sonic-net/sonic-buildimage",
)
