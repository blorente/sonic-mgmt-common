module(
    name = "sonic-mgmt-common",
    version = "1.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "package_metadata", version = "0.0.6")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "protobuf", version = "29.0", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.46.0")
bazel_dep(name = "grpc", version = "1.56.3.bcr.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "bazel_lib", version = "3.1.1")
bazel_dep(name = "sonic-build-infra", version = "0.0.0", repo_name = "sonic_build_infra")
bazel_dep(name = "rules_cc", version = "0.2.14")

register_toolchains("@sonic_build_infra//toolchains/gcc:host_gcc_toolchain")

# rules_distroless for hermetic Debian package dependencies
bazel_dep(name = "rules_distroless", version = "0.0.0")
git_override(
    module_name = "rules_distroless",
    commit = "ebfd74a2e07b83235e064bb63ace98a1a5223e02",
    remote = "https://github.com/bazel-contrib/rules_distroless",
)

# Python toolchain configuration
# Note: Python version should be configured in the root module to avoid conflicts
# When used as a dependency, the root module's Python version takes precedence
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
)

# Pip dependencies
# NOTE: Hub name must be unique across modules to avoid conflicts
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_sonic_mgmt_common",
    python_version = "3.11",
    requirements_lock = "//third_party/pip:requirements_lock.txt",
)
use_repo(pip, "pip_sonic_mgmt_common")

# Go toolchain and dependencies
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.0")

# Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Additional Go modules needed by gnmi v0.11.0's BUILD files. These aren't in
# sonic-mgmt-common's go.mod but are required so inject_repo can make them
# visible to sonic_go_repos repos.
go_deps.module(
    path = "github.com/cenkalti/backoff/v4",
    sum = "h1:G2HAfAmvm/GcKan2oOQpBXOd2tT2G57ZnZGWa1PxPBQ=",
    version = "v4.1.1",
)
go_deps.module(
    path = "github.com/openconfig/grpctunnel",
    sum = "h1:t6SvvdfWCMlw0XPlsdxO8EgO+q/fXnTevDjdYREKFwU=",
    version = "v0.0.0-20220819142823-6f5422b8ca70",
)
go_deps.module(
    path = "github.com/protocolbuffers/txtpbfmt",
    sum = "h1:AKJY61V2SQtJ2a2PdeswKk0NM1qF77X+julRNYRxPOk=",
    version = "v0.0.0-20220608084003-fc78c767cd6a",
)
go_deps.module(
    path = "golang.org/x/crypto",
    sum = "h1:euUpcYgM8WcP71gNpTqQCn6rC2t6ULUPiOzfWaXVVfc=",
    version = "v0.32.0",
)

# TODO(bazel-ready): go_deps will warn about incorrect use_repo imports. These are
# expected and can be ignored.

# SONiC-patched ygot and goyang, shared across the SONiC management stack.
sonic_go_repos = use_extension("//:go_repos.bzl", "sonic_go_repos")
use_repo(
    sonic_go_repos,
    "com_github_golang_glog",
    "com_github_google_gousb",
    "com_github_openconfig_gnmi",
    "com_github_openconfig_gnsi",
    "com_github_openconfig_goyang",
    "com_github_openconfig_ygot",
)

# Make ygot's go_deps dependencies visible to the repos created by sonic_go_repos.
inject_repo(sonic_go_repos, "com_github_golang_protobuf")

inject_repo(sonic_go_repos, "com_github_google_go_cmp")

inject_repo(sonic_go_repos, "com_github_kylelemons_godebug")

inject_repo(sonic_go_repos, "org_golang_google_protobuf")

inject_repo(sonic_go_repos, "com_github_grpc_grpc")

inject_repo(sonic_go_repos, "com_google_protobuf")

inject_repo(sonic_go_repos, "rules_proto")

# gnmi v0.11.0's BUILD files reference these repos. They must be injected here
# (where sonic_go_repos is defined) so they're visible regardless of which
# module consumes the extension.
inject_repo(sonic_go_repos, "com_github_cenkalti_backoff_v4")
inject_repo(sonic_go_repos, "com_github_openconfig_grpctunnel")
inject_repo(sonic_go_repos, "com_github_protocolbuffers_txtpbfmt")
inject_repo(sonic_go_repos, "org_golang_google_grpc")
inject_repo(sonic_go_repos, "org_golang_x_crypto")
inject_repo(sonic_go_repos, "org_golang_x_net")

# For gousb's patched BUILD file.
inject_repo(sonic_go_repos, "bookworm")
inject_repo(sonic_go_repos, "rules_cc")

# TODO BL: If we end up not doing this, uncomment
# inject_repo(sonic_go_repos, "org_golang_google_grpc")

# antchfx packages need SONiC-specific patches; use go_repository directly
# so we can apply -p1 patches without go_deps.module_override (root-only).
go_repository = use_repo_rule("@gazelle//:deps.bzl", "go_repository")

go_repository(
    name = "com_github_antchfx_xpath",
    importpath = "github.com/antchfx/xpath",
    patch_args = ["-p1"],
    patches = ["//patches:xpath.patch"],
    sum = "h1:cJ0pOvEdN/WvYXxvRrzQH9x5QWKpzHacYO8qzCcDYAg=",
    version = "v1.1.10",
)

go_repository(
    name = "com_github_antchfx_jsonquery",
    importpath = "github.com/antchfx/jsonquery",
    patch_args = ["-p1"],
    patches = ["//patches:jsonquery.patch"],
    sum = "h1:+OlFO3QS9wjU0MKx9MgHm5f6o6hdd4e9mUTp0wTjxlM=",
    version = "v1.1.4",
)

go_repository(
    name = "com_github_antchfx_xmlquery",
    importpath = "github.com/antchfx/xmlquery",
    patch_args = ["-p1"],
    patches = ["//patches:xmlquery.patch"],
    sum = "h1:nIKWdtnhrXtj0/IRUAAw2I7TfpHUa3zMnHvNmPXFg+w=",
    version = "v1.3.1",
)

# Expose all Go repositories that are referenced in BUILD files
use_repo(
    go_deps,
    "com_github_cenkalti_backoff_v4",
    "com_github_go_redis_redis_v7",
    "com_github_godbus_dbus_v5",
    "com_github_golang_protobuf",
    "com_github_golang_groupcache",
    "com_github_google_go_cmp",
    "com_github_kylelemons_godebug",
    "com_github_maruel_natural",
    "com_github_openconfig_grpctunnel",
    "com_github_philopon_go_toposort",
    "com_github_pkg_profile",
    "com_github_protocolbuffers_txtpbfmt",
    "com_github_redis_go_redis_v9",
    "com_github_tredoe_osutil",
    "com_github_workiva_go_datastructures",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
    "org_golang_x_net",
    "org_golang_x_text",
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "bookworm",
        "bookworm-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20251001T023456Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["bookworm-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20251001T023456Z"],
)
apt.install(
    dependency_set = "bookworm",
    packages = [
        "libpcre3",
        "libpcre3-dev",
        "libusb-1.0-0-dev",
        "libudev1",
    ],
    suites = [
        "bookworm",
        "bookworm-updates",
        "bookworm-security",
    ],
)
apt.lock(into = ":packages.lock")
use_repo(apt, "bookworm")

bazel_dep(name = "libyang", version = "1.0.73", repo_name = "com_github_cesnet_libyang")
