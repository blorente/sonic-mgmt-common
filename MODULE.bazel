module(
    name = "sonic_mgmt_common",
    version = "1.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_foreign_cc", version = "0.12.0")
bazel_dep(name = "protobuf", version = "29.0")
bazel_dep(name = "rules_go", version = "0.53.0")
bazel_dep(name = "gazelle", version = "0.46.0")

# Python toolchain configuration
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.8",
)

# Pip dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.8",
    requirements_lock = "//third_party/pip:requirements_lock.txt",
)
use_repo(pip, "pip")

# Go toolchain and dependencies
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.10")

# Go dependencies from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Apply patches to Go dependencies that require customization
# gnmi: Patch code only, let Gazelle generate BUILD files with proto mode disabled
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:github.com-openconfig-gnmi.patch",
    ],
    path = "github.com/openconfig/gnmi",
    strip_prefix = "gnmi-0.11.0",
    urls = ["https://github.com/openconfig/gnmi/archive/refs/tags/v0.11.0.tar.gz"],
)
go_deps.gazelle_override(
    build_file_generation = "clean",  # Delete existing BUILD files and regenerate
    directives = [
        "gazelle:proto disable",  # Use pre-compiled .pb.go files
    ],
    path = "github.com/openconfig/gnmi",
)
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:github.com-openconfig-ygot.patch",
        "//patches/ygot:ygot.patch",
    ],
    path = "github.com/openconfig/ygot",
    strip_prefix = "ygot-0.13.1",
    urls = ["https://github.com/openconfig/ygot/archive/refs/tags/v0.13.1.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches/goyang:goyang.patch",
    ],
    path = "github.com/openconfig/goyang",
    strip_prefix = "goyang-0.2.9",
    urls = ["https://github.com/openconfig/goyang/archive/refs/tags/v0.2.9.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:jsonquery.patch",
    ],
    path = "github.com/antchfx/jsonquery",
    strip_prefix = "jsonquery-1.1.4",
    urls = ["https://github.com/antchfx/jsonquery/archive/refs/tags/v1.1.4.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:xmlquery.patch",
    ],
    path = "github.com/antchfx/xmlquery",
    strip_prefix = "xmlquery-1.3.1",
    urls = ["https://github.com/antchfx/xmlquery/archive/refs/tags/v1.3.1.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:xpath.patch",
    ],
    path = "github.com/antchfx/xpath",
    strip_prefix = "xpath-1.1.10",
    urls = ["https://github.com/antchfx/xpath/archive/refs/tags/v1.1.10.tar.gz"],
)
go_deps.archive_override(
    patch_strip = 1,
    patches = [
        "//patches:glog.patch",
    ],
    path = "github.com/golang/glog",
    strip_prefix = "glog-23def4e6c14b4da8ac2ed8007337bc5eb5007998",
    urls = ["https://github.com/golang/glog/archive/23def4e6c14b4da8ac2ed8007337bc5eb5007998.tar.gz"],
)

# Expose all Go repositories that are referenced in BUILD files
use_repo(
    go_deps,
    "com_github_antchfx_jsonquery",
    "com_github_antchfx_xmlquery",
    "com_github_antchfx_xpath",
    "com_github_go_redis_redis_v7",
    "com_github_godbus_dbus_v5",
    "com_github_golang_glog",
    "com_github_golang_groupcache",
    "com_github_google_go_cmp",
    "com_github_kylelemons_godebug",
    "com_github_maruel_natural",
    "com_github_openconfig_gnmi",
    "com_github_openconfig_goyang",
    "com_github_openconfig_ygot",
    "com_github_philopon_go_toposort",
    "com_github_pkg_profile",
    "com_github_redis_go_redis_v9",
    "com_github_tredoe_osutil",
    "com_github_workiva_go_datastructures",
    "org_golang_google_grpc",
    "org_golang_x_text",
)

git_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl",
    "git_repository",
)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# Custom repositories not in BCR
git_repository(
    name = "sonic-buildimage",
    branch = "master",
    build_file = "//third_party/sonic_build_image:BUILD.external.bazel",
    remote = "https://github.com/sonic-net/sonic-buildimage",
)

# PCRE library (required by libyang)
http_archive(
    name = "pcre_archive",
    add_prefix = "pcre",
    build_file_content = """
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "pcre_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

cmake(
    name = "pcre",
    lib_source = ":pcre_srcs",
    working_directory = "pcre/",
    cache_entries = {
        "CMAKE_C_FLAGS": "-fPIC",
        "PCRE_SUPPORT_UNICODE_PROPERTIES": "ON",
    },
    out_static_libs = [
        "libpcre.a",
        "libpcrecpp.a",
        "libpcreposix.a",
    ],
)
""",
    sha256 = "4dae6fdcd2bb0bb6c37b5f97c33c2be954da743985369cddac3546e3218bffb8",
    strip_prefix = "pcre-8.45",
    urls = [
        "https://sourceforge.net/projects/pcre/files/pcre/8.45/pcre-8.45.tar.bz2",
    ],
)

# Libyang library
http_archive(
    name = "com_github_cesnet_libyang",
    build_file_content = """
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

cmake(
    name = "libyang",
    lib_source = ":all_srcs",
    cache_entries = {
        "PLUGINS_DIR": "lib/libyang",
    },
    # Using shared libs here.  When using static libs the libyang.a archive
    # contains undefined references to "extension" libraries which libyang
    # builds but does not install.  This results in linker errors later on
    # complaining that libyang.a does not define: nacm, metadata, yangdata,
    # user_yang_types, and user_inet_types.  These are all defined in .a
    # archives but are abandond in the libyang build directory when the
    # ENABLE_STATIC option is used.
    out_shared_libs = ["libyang.so", "libyang.so.1", "libyang.so.1.2.2"],
    out_data_dirs = ["lib/libyang"],
    deps = [
        "@pcre_archive//:pcre",
    ],
)
""",
    patch_args = ["-p1"],
    patches = [
        "//patches:libyang-repo.patch",
        "//patches:libyang.patch",
    ],
    sha256 = "411f0c675b0858f8deabc0545e33fbd791ff7c7a5b7d2c27e347e3973d5b8ae4",
    strip_prefix = "libyang-1.0-r4",
    urls = [
        "https://github.com/CESNET/libyang/archive/refs/tags/v1.0-r4.tar.gz",
    ],
)
