load("@io_bazel_rules_go//go:def.bzl", "go_test")

# NOTE: These are manual integration tests that require a running Redis instance.
# They use package main with main() instead of Test* functions, so they report
# "no tests to run" but are kept for manual developer testing.
# Run individually with: bazel test //translib/db/test:testdb_test --test_tag_filters=

go_test(
    name = "arloIssue29_test",
    srcs = ["arloIssue29.go"],
    data = [
        "//tools/test:database_config.json",
        "//cvl/conf:cvl_cfg.json",
    ],
    # Set DB_CONFIG_PATH to point to the config file in runfiles
    env = {
        "DB_CONFIG_PATH": "tools/test/database_config.json",
    },
    # Run from the runfiles root so relative paths work
    rundir = ".",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//translib/db",
        "//translib/tlerr",
        "@com_github_golang_glog//:glog",
    ],
)

